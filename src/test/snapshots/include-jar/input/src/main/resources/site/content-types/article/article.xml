<?xml version="1.0" encoding="UTF-8"?>
<content-type xmlns="urn:enonic:xp:model:1.0">
  <display-name>Article (local file is used instead of the file in the jar)</display-name>
  <super-type>base:structured</super-type>
  <form>
    <input name="title" type="TextLine">
      <label>Title</label>
    </input>

    <!-- Mixin from the jar -->
    <item-set name="links">
      <label>Links</label>
      <occurrences minimum="0" maximum="0"/>
      <items>
        <mixin name="jar-link"/>
      </items>
    </item-set>
  </form>
</content-type>
