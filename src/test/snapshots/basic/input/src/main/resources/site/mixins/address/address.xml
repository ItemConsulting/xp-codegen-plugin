<?xml version="1.0" encoding="UTF-8"?>
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name>Address</display-name>
  <form>
    <input name="street" type="TextLine">
      <label>Street</label>
    </input>

    <input name="postalCode" type="TextLine">
      <label>Postal code</label>
      <config>
        <regexp>^\d{4}$</regexp>
      </config>
    </input>

    <mixin name="link"/>
  </form>
</mixin>
