<?xml version="1.0" encoding="UTF-8"?>
<content-type xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="allInputs.displayName">All inputs</display-name>
  <super-type>base:structured</super-type>
  <form>
    <input name="textLine" type="TextLine">
      <label i18n="allInputs.textLine">Text line</label>
    </input>

    <input name="requiredTextLine" type="TextLine">
      <label i18n="allInputs.requiredTextLine">Required text line</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="textLines" type="TextLine">
      <label>Text lines</label>
      <occurrences minimum="0" maximum="0"/>
    </input>

    <input name="requiredTextLines" type="TextLine">
      <label>Required text lines</label>
      <occurrences minimum="2" maximum="5"/>
    </input>

    <input name="textLineWithRegexp" type="TextLine">
      <label>Text line with regexp</label>
      <config>
        <regexp>^[a-z]+$</regexp>
      </config>
    </input>

    <input name="textLineWithMaxLength" type="TextLine">
      <label>Text line with max length</label>
      <config>
        <max-length>10</max-length>
      </config>
    </input>

    <input name="textArea" type="TextArea">
      <label>Text area</label>
    </input>

    <input name="htmlArea" type="HtmlArea">
      <label>Html area</label>
    </input>

    <input name="long" type="Long">
      <label>Long</label>
    </input>

    <input name="longWithMinAndMax" type="Long">
      <label>Long with min and max</label>
      <config>
        <min>1</min>
        <max>10</max>
      </config>
    </input>

    <input name="doubles" type="Double">
      <label>Doubles</label>
      <occurrences minimum="1" maximum="0"/>
    </input>

    <input name="date" type="Date">
      <label>Date</label>
    </input>

    <input name="time" type="Time">
      <label>Time</label>
    </input>

    <input name="dateTime" type="DateTime">
      <label>Date time</label>
    </input>

    <input name="checkBox" type="CheckBox">
      <label>Check box</label>
      <occurrences minimum="0" maximum="0"/>
    </input>

    <input name="comboBox" type="ComboBox">
      <label>Combo box</label>
      <occurrences minimum="0" maximum="0"/>
      <config>
        <option value="one">One</option>
        <option value="two">Two</option>
        <option value="one">One again</option>
      </config>
    </input>

    <input name="radioButton" type="RadioButton">
      <label>Radio button</label>
      <occurrences minimum="1" maximum="0"/>
      <config>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </config>
    </input>

    <input name="contentSelector" type="ContentSelector">
      <label>Content selector</label>
      <occurrences minimum="0" maximum="0"/>
    </input>

    <input name="imageSelector" type="ImageSelector">
      <label>Image selector</label>
    </input>

    <input name="mediaSelector" type="MediaSelector">
      <label>Media selector</label>
    </input>

    <input name="attachmentUploader" type="AttachmentUploader">
      <label>Attachment uploader</label>
    </input>

    <input name="customSelector" type="CustomSelector">
      <label>Custom selector</label>
      <config>
        <service>my-service</service>
      </config>
    </input>

    <input name="tag" type="Tag">
      <label>Tag</label>
      <occurrences minimum="0" maximum="0"/>
    </input>

    <input name="geoPoint" type="GeoPoint">
      <label>Geo point</label>
    </input>

    <input name="contentTypeFilter" type="ContentTypeFilter">
      <label>Content type filter</label>
    </input>

    <input name="unknownType" type="MyCustomInput">
      <label>Unknown type</label>
    </input>

    <input name="my-hyphenated-field" type="TextLine">
      <label>Hyphenated field</label>
    </input>

    <input name="withoutLabel" type="TextLine"/>

    <input name="multiLineLabel" type="TextLine">
      <label>
        First line
        Second line
      </label>
    </input>

    <input name="withoutType">
      <label>Inputs without type are ignored</label>
    </input>

    <input type="TextLine">
      <label>Inputs without name are ignored</label>
    </input>
  </form>
</content-type>
