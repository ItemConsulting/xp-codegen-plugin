<?xml version="1.0" encoding="UTF-8"?>
<content-type xmlns="urn:enonic:xp:model:1.0">
  <display-name>Sets</display-name>
  <super-type>base:structured</super-type>
  <form>
    <field-set>
      <label>Field set</label>
      <items>
        <input name="fieldSetTitle" type="TextLine">
          <label>Field set title</label>
          <occurrences minimum="1" maximum="1"/>
        </input>
      </items>
    </field-set>

    <item-set name="contact">
      <label>Contact</label>
      <occurrences minimum="1" maximum="1"/>
      <items>
        <input name="email" type="TextLine">
          <label>Email</label>
        </input>

        <item-set name="phoneNumbers">
          <label>Phone numbers</label>
          <occurrences minimum="0" maximum="0"/>
          <items>
            <input name="number" type="TextLine">
              <label>Number</label>
              <occurrences minimum="1" maximum="1"/>
            </input>
          </items>
        </item-set>
      </items>
    </item-set>

    <item-set name="emptyItemSet">
      <label>Empty item set</label>
      <items/>
    </item-set>

    <option-set name="singleSelect">
      <label>Single select</label>
      <occurrences minimum="1" maximum="1"/>
      <options minimum="1" maximum="1">
        <option name="none">
          <label>None</label>
        </option>
        <option name="text">
          <label>Text</label>
          <items>
            <input name="text" type="TextArea">
              <label>Text</label>
            </input>
          </items>
        </option>
      </options>
    </option-set>

    <option-set name="multiSelect">
      <label>Multi select</label>
      <options minimum="0" maximum="0">
        <option name="first">
          <label>First</label>
        </option>
        <option name="second">
          <label>Second</label>
          <items>
            <input name="count" type="Long">
              <label>Count</label>
            </input>
          </items>
        </option>
      </options>
    </option-set>

    <option-set name="optionSetArray">
      <label>Option set array</label>
      <occurrences minimum="0" maximum="0"/>
      <options minimum="1" maximum="1">
        <option name="nested">
          <label>Nested</label>
          <items>
            <option-set name="nestedOptionSet">
              <label>Nested option set</label>
              <options minimum="1" maximum="1">
                <option name="a">
                  <label>A</label>
                </option>
              </options>
            </option-set>
          </items>
        </option>
      </options>
    </option-set>
  </form>
</content-type>
