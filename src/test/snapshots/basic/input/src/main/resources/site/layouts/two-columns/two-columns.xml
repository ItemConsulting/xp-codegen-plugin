<?xml version="1.0" encoding="UTF-8"?>
<layout xmlns="urn:enonic:xp:model:1.0">
  <display-name>Two columns</display-name>
  <form>
    <input name="columnRatio" type="ComboBox">
      <label>Column ratio</label>
      <occurrences minimum="1" maximum="1"/>
      <config>
        <option value="50-50">50/50</option>
        <option value="30-70">30/70</option>
      </config>
    </input>
  </form>
  <regions>
    <region name="left"/>
    <region name="right"/>
  </regions>
</layout>
