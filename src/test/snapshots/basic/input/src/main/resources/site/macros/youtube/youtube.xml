<?xml version="1.0" encoding="UTF-8"?>
<macro xmlns="urn:enonic:xp:model:1.0">
  <display-name>YouTube</display-name>
  <form>
    <input name="url" type="TextLine">
      <label>Url</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="width" type="Long">
      <label>Width</label>
    </input>

    <input name="autoplay" type="CheckBox">
      <label>Autoplay</label>
    </input>

    <input name="size" type="ComboBox">
      <label>Size</label>
      <config>
        <option value="small">Small</option>
        <option value="large">Large</option>
      </config>
    </input>
  </form>
</macro>
